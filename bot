    gap: 6px;
}
.typing-indicator {
    display: flex;
    gap: 4px;
    padding: 8px 12px;
    background: white;
    border-radius: 18px;
    width: fit-content;
}
.typing-indicator span {
    width: 8px;
    height: 8px;
    background: #9CA3AF;
    border-radius: 50%;
    animation: typing 1.4s infinite ease-in-out;
}
.typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
.typing-indicator span:nth-child(3) { animation-delay: 0.4s; }
@keyframes typing {
    0%, 60%, 100% { transform: translateY(0); }
    30% { transform: translateY(-6px); }
}
</style>

<div class="chatbot-container">
    <div class="chatbot-button" id="chatbotButton">
        <i class="fas fa-comment-dots"></i>
    </div>
    <div class="chatbot-window" id="chatbotWindow">
        <div class="chatbot-header">
            <h3><i class="fas fa-robot"></i> BISL Assistant</h3>
            <button id="closeChatbot">&times;</button>
        </div>
        <div id="chatbotContent" style="flex: 1; display: flex; flex-direction: column; overflow: hidden;"></div>
    </div>
</div>

<script>
// Configuration
const WHATSAPP_NUMBER = "254717111749"; // Your number (without +)
const ADMIN_EMAIL = "fessycompass@gmail.com"; // BISL email for notifications

// State
let currentView = 'options';
let chatMessages = [];

// DOM elements
const chatbotButton = document.getElementById("chatbotButton");
const chatbotWindow = document.getElementById("chatbotWindow");
const closeChatbot = document.getElementById("closeChatbot");
const chatbotContent = document.getElementById("chatbotContent");

// Open/close
chatbotButton.addEventListener("click", () => {
    chatbotWindow.classList.toggle("open");
    if (chatbotWindow.classList.contains("open") && currentView === 'options') {
        renderOptionsScreen();
    }
});
closeChatbot.addEventListener("click", () => {
    chatbotWindow.classList.remove("open");
});

// Knowledge base
const botResponses = {
    "what do you do": "BISL provides an integrated digital platform for SMEs: web development, SEO, mobile apps, and data reporting — all in one package.",
    "services": "We offer: 1) Fast websites, 2) Mobile/PWA apps, 3) SEO & data dashboards, 4) E-commerce solutions.",
    "pricing": "Our packages are scalable and affordable. Please contact us for a custom quote based on your business needs.",
    "contact": "You can reach us at Ikeja GRA, Lagos, call +234 (811) 760-2673, or email akinbolawa90@gmail.com",
    "mobile app": "Yes! We build and publish mobile apps for iOS and Android.",
    "seo": "We provide advanced SEO with APIs, dashboards, and 24/7 data reporting.",
    "appointment": "You can book an appointment by clicking the 'Book an Appointment' option on our main menu.",
    "default": "Thanks for your question! Would you like to book a free consultation appointment? Just say 'appointment' or ask me anything else."
};

function getBotReply(message) {
    const lowerMsg = message.toLowerCase();
    for (const [key, reply] of Object.entries(botResponses)) {
        if (lowerMsg.includes(key)) return reply;
    }
    return botResponses["default"];
}

// Send WhatsApp notification
async function sendWhatsAppNotification(appointment) {
    const message = `🔔 *NEW APPOINTMENT REQUEST - BISL* 🔔\n\n👤 Name: ${appointment.name}\n📧 Email: ${appointment.email}\n📞 Phone: ${appointment.phone || 'Not provided'}\n🛠️ Service: ${appointment.service}\n📅 Date: ${appointment.date || 'Not specified'}\n⏰ Time: ${appointment.time || 'Not specified'}\n📝 Notes: ${appointment.notes || 'None'}\n\n🌐 From BISL Website Chatbot`;
    const encodedMsg = encodeURIComponent(message);
    const whatsappUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodedMsg}`;
    window.open(whatsappUrl, '_blank');
}

// Send email notification (via mailto - opens default email client)
function sendEmailNotification(appointment) {
    const subject = `New Appointment Request from ${appointment.name}`;
    const body = `New appointment request from BISL website chatbot:\n\nName: ${appointment.name}\nEmail: ${appointment.email}\nPhone: ${appointment.phone || 'Not provided'}\nService: ${appointment.service}\nPreferred Date: ${appointment.date || 'Not specified'}\nPreferred Time: ${appointment.time || 'Not specified'}\nAdditional Notes: ${appointment.notes || 'None'}\n\nPlease contact this lead within 24 hours.`;
    window.location.href = `mailto:${ADMIN_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
}

// Submit appointment
async function submitAppointment() {
    const name = document.getElementById("apptName")?.value.trim();
    const email = document.getElementById("apptEmail")?.value.trim();
    const phone = document.getElementById("apptPhone")?.value.trim();
    const service = document.getElementById("apptService")?.value;
    const date = document.getElementById("apptDate")?.value;
    const time = document.getElementById("apptTime")?.value;
    const notes = document.getElementById("apptNotes")?.value;
    
    if (!name || !email || !service) {
        alert("Please fill in name, email, and select a service.");
        return;
    }
    
    const appointment = { name, email, phone, service, date, time, notes, timestamp: new Date().toISOString() };
    
    // Show loading
    const submitBtn = document.getElementById("submitAppointment");
    const originalText = submitBtn.innerText;
    submitBtn.innerText = "Sending...";
    submitBtn.disabled = true;
    
    try {
        // Send WhatsApp notification
        await sendWhatsAppNotification(appointment);
        
        // Send email notification
        sendEmailNotification(appointment);
        
        // Store locally
        console.log("Appointment booked:", appointment);
        
        alert(`✅ Thank you ${name}! Your consultation request for ${service} has been sent.\n\nWe'll contact you via WhatsApp and email within 24 hours.`);
        renderOptionsScreen();
    } catch (error) {
        console.error("Error:", error);
        alert("There was an issue. Your request was logged. We'll contact you soon.");
        renderOptionsScreen();
    }
}

// Render options screen
function renderOptionsScreen() {
    currentView = 'options';
    chatbotContent.innerHTML = `
        <div class="options-screen">
            <div class="option-card" id="bookAppointmentOption">
                <div class="option-icon">📅</div>
                <div class="option-title">Book an Appointment</div>
                <div class="option-desc">Choose a service, date & time</div>
            </div>
            <div class="option-card" id="chatWithAIOption">
                <div class="option-icon">💬</div>
                <div class="option-title">Chat with AI Assistant</div>
                <div class="option-desc">Ask questions or get help</div>
            </div>
            <div style="font-size: 11px; color: #9CA3AF; text-align: center; margin-top: 16px;">
                Powered by BISL
            </div>
        </div>
    `;
    document.getElementById("bookAppointmentOption")?.addEventListener("click", renderAppointmentForm);
    document.getElementById("chatWithAIOption")?.addEventListener("click", () => {
        renderChatScreen();
        addBotMessage("Hi! I'm BISL's AI assistant. Ask me about our services, pricing, mobile apps, SEO, or anything else!");
    });
}

// Render appointment form
function renderAppointmentForm() {
    currentView = 'appointment';
    chatbotContent.innerHTML = `
        <div style="flex: 1; display: flex; flex-direction: column; overflow: hidden;">
            <div style="padding: 12px 16px 0 16px;">
                <button class="back-button" id="backToOptions">
                    ← Back
                </button>
            </div>
            <div class="appointment-form" style="flex: 1; overflow-y: auto;">
                <h4>📅 Book a Free Consultation</h4>
                <input type="text" id="apptName" placeholder="Full name *">
                <input type="email" id="apptEmail" placeholder="Email address *">
                <input type="tel" id="apptPhone" placeholder="Phone number">
                <select id="apptService">
                    <option value="">Select service *</option>
                    <option value="Website Development">Website Development</option>
                    <option value="Mobile App Development">Mobile App Development</option>
                    <option value="SEO & Digital Marketing">SEO & Digital Marketing</option>
                    <option value="E-commerce Solution">E-commerce Solution</option>
                    <option value="Full Digital Transformation">Full Digital Transformation</option>
                </select>
                <input type="date" id="apptDate">
                <input type="time" id="apptTime">
                <textarea id="apptNotes" rows="2" placeholder="Additional notes (optional)"></textarea>
                <button id="submitAppointment">Submit Request →</button>
            </div>
        </div>
    `;
    document.getElementById("backToOptions")?.addEventListener("click", renderOptionsScreen);
    document.getElementById("submitAppointment")?.addEventListener("click", submitAppointment);
}

// Render chat screen
function renderChatScreen() {
    currentView = 'chat';
    chatbotContent.innerHTML = `
        <div style="flex: 1; display: flex; flex-direction: column; overflow: hidden;">
            <div style="padding: 12px 16px 8px 16px; border-bottom: 1px solid #E5E7EB;">
                <button class="back-button" id="backToOptionsChat">
                    ← Back to menu
                </button>
            </div>
            <div id="chatMessagesList" class="chatbot-messages" style="flex: 1; overflow-y: auto;"></div>
            <div class="chatbot-input">
                <input type="text" id="chatInput" placeholder="Type your message...">
                <button id="sendChatBtn">Send</button>
            </div>
        </div>
    `;
    
    document.getElementById("backToOptionsChat")?.addEventListener("click", renderOptionsScreen);
    
    const messagesContainer = document.getElementById("chatMessagesList");
    chatMessages.forEach(msg => {
        const msgDiv = document.createElement("div");
        msgDiv.className = `message ${msg.sender}`;
        msgDiv.innerText = msg.text;
        messagesContainer?.appendChild(msgDiv);
    });
    
    const chatInput = document.getElementById("chatInput");
    const sendBtn = document.getElementById("sendChatBtn");
    
    function sendMessage() {
        const text = chatInput.value.trim();
        if (!text) return;
        
        chatMessages.push({ sender: "user", text: text });
        const msgDiv = document.createElement("div");
        msgDiv.className = "message user";
        msgDiv.innerText = text;
        messagesContainer?.appendChild(msgDiv);
        chatInput.value = "";
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
        
        const typingDiv = document.createElement("div");
        typingDiv.className = "typing-indicator";
        typingDiv.id = "typingIndicator";
        typingDiv.innerHTML = "<span></span><span></span><span></span>";
        messagesContainer?.appendChild(typingDiv);
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
        
        setTimeout(() => {
            document.getElementById("typingIndicator")?.remove();
            const reply = getBotReply(text);
            chatMessages.push({ sender: "bot", text: reply });
            const botDiv = document.createElement("div");
            botDiv.className = "message bot";
            botDiv.innerText = reply;
            messagesContainer?.appendChild(botDiv);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }, 600);
    }
    
    sendBtn?.addEventListener("click", sendMessage);
    chatInput?.addEventListener("keypress", (e) => { if (e.key === "Enter") sendMessage(); });
}

function addBotMessage(text) {
    const messagesContainer = document.getElementById("chatMessagesList");
    if (!messagesContainer) return;
    chatMessages.push({ sender: "bot", text: text });
    const msgDiv = document.createElement("div");
    msgDiv.className = "message bot";
    msgDiv.innerText = text;
    messagesContainer.appendChild(msgDiv);
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
}

// Initialize
renderOptionsScreen();
</script>
</body>
</html>
